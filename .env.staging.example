APP_NAME="Xplorelanka"
APP_ENV=staging
APP_KEY=                                      # Generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://staging.xplorelanka.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=10

LOG_CHANNEL=daily
LOG_LEVEL=debug

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xplorelanka_staging
DB_USERNAME=xplorelanka
DB_PASSWORD=change_this_staging_password      # Use a real password

# Redis Cache, Session, Queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use a separate staging bucket or prefix from production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail — use log driver on staging to avoid sending real emails
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@your-domain.com"
MAIL_FROM_NAME="${APP_NAME} (Staging)"

VITE_APP_NAME="${APP_NAME}"
