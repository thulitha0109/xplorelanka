APP_NAME="Xplore Lanka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://xplorelanka.com
SEO_URL=https://xplorelanka.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xplorelanka
DB_USERNAME=xplorelanka
DB_PASSWORD=change_me_to_a_long_random_password

BROADCAST_CONNECTION=log
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=xplorelanka.com
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional S3-compatible endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public CDN/bucket URL used to generate browser-facing media URLs; never use an internal endpoint here.
AWS_URL=
# Set true for S3-compatible providers that require path-style addressing (e.g. many MinIO setups).
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@xplorelanka.com
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_APP_NAME="${APP_NAME}"

# Leave unset until a real payment gateway and webhook secret are configured.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=
