# Version control
.git
.github

# Node / PHP dependencies (rebuilt inside the image)
node_modules
vendor

# Laravel runtime data is mounted/persistent at runtime and is owned by the
# container's www-data user. Exclude the whole tree so Docker never tries to
# traverse host runtime files/directories with restrictive permissions.
storage
public/storage

# PHP-FPM bootstrap cache
bootstrap/cache/*.php

# Compiled frontend assets (built inside the image)
public/build
public/hot

# Environment files
.env
.env.*

# Deployment artefacts
.backups
deploy.log
.deploy-tag
.proxy-configured

# Editor / OS junk
.DS_Store
.idea
.vscode
npm-debug.log
