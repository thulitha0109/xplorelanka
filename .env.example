# Copy to .env, keep mode 600, and fill in the host-specific values.
# Generate secrets with: bash deploy/setup-env.sh

COMPOSE_PROJECT_NAME=xplorelanka
APP_NAME="Xplore Lanka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Compose runs PostgreSQL in a private network with a persistent named volume.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xplorelanka
DB_USERNAME=xplorelanka
DB_PASSWORD=

# Private Compose-network Redis for cache, sessions, queues, and maintenance.
BROADCAST_CONNECTION=log
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Persistent local uploads work out of the box. For S3, set FILESYSTEM_DISK=s3
# and fill all AWS_* values; the S3 bucket/credentials must already exist.
FILESYSTEM_DISK=public
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
AWS_ACCESS_KEY_ID=xplorelanka_minio
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xplorelanka
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional legacy/self-hosted S3-compatible storage (Compose profile: minio).
# deploy.sh enables it only when AWS_ENDPOINT=http://minio:9000.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host Nginx connects using FastCGI. Use a different FPM_PORT and
# COMPOSE_PROJECT_NAME for another stack on the same server.
FPM_BIND=127.0.0.1
FPM_PORT=9000
STORAGE_PATH=./storage

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="${APP_NAME}"

# This is a browser-visible Vite build value; use a key restricted by referrer.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_APP_NAME="${APP_NAME}"

FX_USD_TO_EUR=0.92
FX_USD_TO_LKR=300

PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=
