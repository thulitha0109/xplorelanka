# =============================================================================
# Xplore Lanka – Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in every value marked CHANGE_ME.
# Keep .env on the server only (it is git-ignored and must be mode 600).
#
# Generate secrets quickly:
#   APP_KEY  → php artisan key:generate --show
#   DB_PASSWORD → openssl rand -hex 32
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Xplore Lanka"
APP_ENV=production
APP_KEY=                         # CHANGE_ME – generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://xplorelanka.com
SEO_URL=https://xplorelanka.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning                # Use "debug" only when diagnosing issues

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db                       # Docker service name – do not change
DB_PORT=5432
DB_DATABASE=xplorelanka
DB_USERNAME=xplorelanka
DB_PASSWORD=                     # CHANGE_ME – use a strong random password

# ── Redis (Cache / Session / Queue) ──────────────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=xplorelanka.com
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis                 # Docker service name – do not change
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── MinIO (self-hosted S3-compatible object storage) ─────────────────────────
# These credentials are used by the MinIO container itself AND by Laravel (via
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below).
MINIO_ROOT_USER=                 # CHANGE_ME – e.g. xplorelanka_admin
MINIO_ROOT_PASSWORD=             # CHANGE_ME – openssl rand -hex 24

# ── Storage (MinIO / S3-compatible) ──────────────────────────────────────────
FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true

# Use the same credentials as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above
# (or create a dedicated MinIO service account via the :9001 console).
AWS_ACCESS_KEY_ID=               # CHANGE_ME – same as MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=           # CHANGE_ME – same as MINIO_ROOT_PASSWORD
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xplorelanka           # Must match the bucket minio_init creates
# MinIO S3 API endpoint (Docker service name – do not change)
AWS_ENDPOINT=http://minio:9000
# Public URL used to build browser-facing media URLs.
# If MinIO is only on loopback, tunnel it via your reverse proxy, e.g:
#   https://cdn.xplorelanka.com  (proxy pass → http://127.0.0.1:9000/xplorelanka)
# For AWS S3: https://<bucket>.s3.<region>.amazonaws.com
# For R2: https://pub-<hash>.r2.dev  (or your custom domain)
AWS_URL=                         # CHANGE_ME
# Required for MinIO (and some S3-compatible providers)
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=                       # CHANGE_ME – e.g. smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=                   # CHANGE_ME
MAIL_PASSWORD=                   # CHANGE_ME
MAIL_FROM_ADDRESS=info@xplorelanka.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=             # CHANGE_ME
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_APP_NAME="${APP_NAME}"

# ── Seeding (optional – only used when running db:seed) ───────────────────────
# Used by DatabaseSeeder to create an initial admin account.
SEED_ADMIN_EMAIL=admin@xplorelanka.com
SEED_ADMIN_PASSWORD=             # CHANGE_ME or leave blank to skip admin creation

# ── Currency / FX (catalog display fallbacks) ────────────────────────────────
FX_USD_TO_EUR=0.92
FX_USD_TO_LKR=300

# ── Payment Gateway ───────────────────────────────────────────────────────────
# Leave all unset until a payment provider is integrated.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=
