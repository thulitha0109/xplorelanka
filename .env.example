APP_NAME="Xplor Lanka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SEO_URL=https://xplorelanka.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database (Container default: db:5432)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xplorelanka
DB_USERNAME=xplorelanka
DB_PASSWORD=secret

# Redis Cache, Session, Queue (Container default: redis:6379)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@xplorelanka.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Maps / APIs
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# MinIO / S3 Storage Configuration
MINIO_ROOT_USER=xplore_minio
MINIO_ROOT_PASSWORD=xplore_secret_key
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=xplore_minio
AWS_SECRET_ACCESS_KEY=xplore_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xplorelanka
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/xplorelanka
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Local-only convenience account for database seeding. Set a strong secret
# explicitly for a production admin account; seeding skips admin creation if blank.
SEED_ADMIN_EMAIL=admin@xplorelanka.com
SEED_ADMIN_PASSWORD=

# Catalog display conversion fallbacks (USD is the reference currency).
# Persisted catalog prices are used at checkout; update these and run
# `php artisan catalog:sync-currency-prices` to refresh FX-generated entries.
FX_USD_TO_EUR=0.92
FX_USD_TO_LKR=300

# Leave unset until a hosted gateway adapter and merchant account are configured.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=

